{
  "service_uuid": "11111111-1111-1111-1111-111111111111",
  "service_name": "Demo Bistro",
  "domain": "demobistro.test",
  "base_url": "http://localhost:9000",
  "auth_type": "oauth2",
  "oauth": {
    "auth_url": "http://localhost:9100/authorize",
    "token_url": "http://localhost:9100/token",
    "scopes": ["read", "order"]
  },
  "endpoints": [
    {
      "id": "search_menu",
      "path": "/menu/search",
      "method": "GET",
      "description": "Search the menu for dishes.",
      "params": [
        {"name": "query", "type": "string", "required": true,
         "location": "query", "description": "Dish name or keyword, e.g. pasta"}
      ]
    },
    {
      "id": "get_order_status",
      "path": "/orders/{order_id}",
      "method": "GET",
      "description": "Get the status of an order by its ID.",
      "params": [
        {"name": "order_id", "type": "string", "required": true,
         "location": "path", "description": "Order ID, e.g. A1042"}
      ]
    },
    {
      "id": "place_order",
      "path": "/orders",
      "method": "POST",
      "description": "Place an order for a dish.",
      "params": [
        {"name": "item", "type": "string", "required": true,
         "location": "body", "description": "Name of the dish to order"},
        {"name": "quantity", "type": "integer", "required": true,
         "location": "body", "description": "Number of portions"}
      ]
    }
  ]
}
