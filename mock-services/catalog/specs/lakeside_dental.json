        }
      ]
    },
    {
      "id": "book_appointment",
      "path": "/appointments",
      "method": "POST",
      "description": "Book an open slot.",
      "params": [
        {
          "name": "slot_id",
          "type": "string",
          "required": true,
          "location": "body",
          "description": "A slot id from next_available, e.g. slot_0914"
        }
      ]
    },
    {
      "id": "my_appointments",
      "path": "/appointments",
      "method": "GET",
      "description": "List your upcoming appointments.",
      "params": []
