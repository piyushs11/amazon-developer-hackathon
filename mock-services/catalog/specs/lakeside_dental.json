      "path": "/appointments/{appointment_id}/cancel",
      "method": "POST",
      "description": "Cancel one of your appointments.",
      "params": [
        {
          "name": "appointment_id",
          "type": "string",
          "required": true,
          "location": "path",
          "description": "Appointment id, e.g. apt_5521"
        }
      ]
    }
  ],
