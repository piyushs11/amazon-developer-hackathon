# ---- shared ----
MODE=local

# ---- Dev 1: catalog + registry ----
DATABASE_URL=postgresql://mcpbridge:mcpbridge@localhost:5432/mcpbridge
# Host port of the Docker Postgres. If Postgres is also installed on this machine (it takes 5432),
# set POSTGRES_PORT=5433 and use :5433 in DATABASE_URL above. Containers always use postgres:5432.
# POSTGRES_PORT=5433
CATALOG_URL=http://localhost:9200

# ---- Dev 2: codegen + storage ----
GENERATED_DIR=./generated
# Redis tool cache (db 15 is reserved for tests)
REDIS_URL=redis://localhost:6379/0
# MODE=aws only: bundles and mapped JSON are stored in this S3 bucket
S3_BUCKET=
# MODE=aws only: files of versions that failed verification (same uuid/version/ layout)
ERROR_S3_BUCKET=
# Bedrock model used to test and patch generated tools (default: Haiku 4.5)
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# How generated tools are verified before they go live:
#   llm  = each tool is called through Bedrock against the service's API (needs AWS credentials)
#   skip = only check each tool file loads (no AWS; for a laptop without Bedrock access)
VERIFY=llm
# Dev token the service provider created for verification, one per service:
#   <SERVICE_NAME>_DEV_TOKEN, e.g. DEMO_BISTRO_DEV_TOKEN=
# (or $GENERATED_DIR/creds/<service>_dev.json). MODE=aws: the Secrets Manager secret
# <service>_dev ({"token": "..."}) first, then the env var above as a fallback.
# AWS region for Bedrock/S3/Secrets Manager/SES (keep a US region for the default model)
AWS_REGION=us-east-1

# Failure email when a tool cannot be auto-onboarded (business email comes from the
# `businesses` table in Postgres; this address is always copied)
AMAZON_SUPPORT_EMAIL=
# Sender address; required for SES in MODE=aws (must be verified in SES).
# In MODE=local emails are only saved to $GENERATED_DIR/outbox/ as .eml files.
ALERT_FROM_EMAIL=

# ---- Dev 3: auth + gateway + deploy ----
# fake = every call uses "demo-token"; memory = real (fake) OAuth tokens in memory;
# local = OAuth tokens encrypted in Postgres
# secrets = OAuth tokens in AWS Secrets Manager (mcp-bridge/<service_uuid>/<user_id>), with the
# encrypted Postgres store as fallback when AWS is unreachable (docker-compose sets this for the app)
TOKEN_PROVIDER=fake
# docker compose (app service) ignores TOKEN_PROVIDER and uses APP_TOKEN_PROVIDER (default
# secrets). Set APP_TOKEN_PROVIDER=local on a laptop to keep tokens in Postgres without AWS.
# APP_TOKEN_PROVIDER=local
TOKEN_ENC_KEY=change-me-local-only
OAUTH_STATE_SECRET=change-me-local-only
PLATFORM_JWT_SECRET=change-me-local-only-at-least-32-bytes
# Fixed token -> "demo-user" (curl / MCP Inspector). Unset to disable.
DEMO_USER_TOKEN=demo-user-token-local
IDENTITY=jwt,fixed
# memory = hand-written Demo Bistro bundle; postgres = Dev 1's registry
REGISTRY=memory
GATEWAY_URL=http://localhost:8000
OAUTH_CLIENT_ID=mcp-bridge
OAUTH_CLIENT_SECRET=mcp-bridge-secret
# Server-side URL rewrites when the app runs in Docker (mocks are not on localhost there):
# UPSTREAM_REWRITES=http://localhost:9000=http://demo-api:9000,http://localhost:9300=http://lakeside:9300,http://localhost:9100=http://oauth:9100
# Browser-facing authorize URL rewrite on EC2:
# AUTHORIZE_REWRITES=http://localhost:9100=https://<domain>/mock-oauth

# ---- Dev 4: api + frontend ----
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# EC2 only: domain Caddy serves (see infra/README.md)
# DOMAIN=mcpbridge.example.com
