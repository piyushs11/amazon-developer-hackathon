# ---- shared ----
MODE=local

# ---- Dev 1: catalog + registry ----
DATABASE_URL=postgresql://mcpbridge:mcpbridge@localhost:5432/mcpbridge
CATALOG_URL=http://localhost:9200

# ---- Dev 2: codegen + storage ----
GENERATED_DIR=./generated

# ---- Dev 3: auth + gateway + deploy ----
# fake = every call uses "demo-token"; memory = real (fake) OAuth tokens in memory;
# local = OAuth tokens encrypted in Postgres
TOKEN_PROVIDER=fake
TOKEN_ENC_KEY=change-me-local-only
OAUTH_STATE_SECRET=change-me-local-only
PLATFORM_JWT_SECRET=change-me-local-only-at-least-32-bytes
# Fixed token -> "demo-user" (curl / MCP Inspector). Unset to disable.
DEMO_USER_TOKEN=demo-user-token-local
IDENTITY=jwt,fixed
# memory = hand-written Demo Bistro bundle; postgres = Dev 1's registry
REGISTRY=memory
GATEWAY_URL=http://localhost:8000
OAUTH_CLIENT_ID=mcp-bridge
OAUTH_CLIENT_SECRET=mcp-bridge-secret
# Server-side URL rewrites when the app runs in Docker (mocks are not on localhost there):
# UPSTREAM_REWRITES=http://localhost:9000=http://demo-api:9000,http://localhost:9100=http://oauth:9100
# Browser-facing authorize URL rewrite on EC2:
# AUTHORIZE_REWRITES=http://localhost:9100=https://<domain>/mock-oauth

# ---- Dev 4: api + frontend ----
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
# EC2 only: domain Caddy serves (see infra/README.md)
# DOMAIN=mcpbridge.example.com
